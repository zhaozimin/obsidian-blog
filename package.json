{
  "name": "obsidian-blog-system",
  "version": "11.2.0",
  "private": true,
  "license": "MIT",
  "description": "空白 Obsidian 笔记库、博客网站与公众号草稿的单插件发布系统",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaozimin/obsidian-blog.git"
  },
  "scripts": {
    "build": "node scripts/build.cjs && node scripts/make-template.cjs && npm run build:web",
    "test": "node --test tests/*.test.cjs scripts/*.test.cjs",
    "check:public": "node scripts/check-public.cjs",
    "check": "npm run check:ui --workspace web && npm run test && npm run check:frontend && npm run build && npm run check:public && npm run check --workspace web && npm run check:content --workspace web && npm run check:cloudflare",
    "check:cloudflare": "node scripts/check-cloudflare.cjs",
    "start": "node server/index.cjs",
    "install:plugin": "node scripts/install.cjs",
    "build:web": "npm run build --workspace web",
    "setup": "node scripts/setup.cjs",
    "dev:system": "node scripts/start-local.cjs",
    "runtime:path": "node scripts/start-local.cjs --path",
    "cloudflare:init": "node scripts/cloudflare.cjs init",
    "cloudflare:deploy": "node scripts/cloudflare.cjs deploy",
    "check:frontend": "node --test web/scripts/frontend-regression.test.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "mp-darkmode": "1.2.2"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "gray-matter": "4.0.3",
    "highlight.js": "11.11.1",
    "marked": "17.0.6",
    "sharp": "0.35.5"
  }
}
